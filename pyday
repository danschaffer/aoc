#!/usr/bin/env bash
# Scaffold a new AoC Python day and download input.
# Usage: ./pyday <day> [year]
#   ./pyday 1            -> 2024/day01-py
#   ./pyday 5 2025       -> 2025/day05-py

set -euo pipefail

DAY="${1:-}"
YEAR="${2:-2024}"

if [[ -z "$DAY" ]]; then
  echo "usage: $0 <day> [year]" >&2
  exit 1
fi

if [[ "$DAY" -gt 25 ]] 2>/dev/null; then
  echo "error: day must be 1-25 (got '$DAY') — did you swap day and year?" >&2
  exit 1
fi

if [[ -z "${COOKIE:-}" ]]; then
  echo "error: \$COOKIE not set (your AoC session cookie)" >&2
  exit 1
fi

DAY_PADDED=$(printf "%02d" "$DAY")
DST="$YEAR/day$DAY_PADDED-py"

if [[ -d "$DST" ]]; then
  echo "$DST already exists, refusing to overwrite" >&2
  exit 1
fi

if [[ ! -f "template.py" ]]; then
  echo "error: template.py not found — run from the repo root" >&2
  exit 1
fi

mkdir -p "$DST"
sed \
  -e "s|Day|Day${DAY_PADDED}|g" \
  -e "s|\./day\.input|\./input.txt|g" \
  -e "s|\./day-test\.input|\./sample.txt|g" \
  -e "s|advent of code: day|advent of code: day${DAY_PADDED}|g" \
  template.py > "$DST/main.py"
chmod +x "$DST/main.py"
echo "created $DST"

INPUT_URL="https://adventofcode.com/$YEAR/day/$DAY/input"
echo "fetching $INPUT_URL ..."
curl -s --fail \
  --cookie "session=$COOKIE" \
  --user-agent "github.com/danschaffer/aoc by dan" \
  "$INPUT_URL" -o "$DST/input.txt"

touch "$DST/sample.txt"

LINES=$(wc -l < "$DST/input.txt" | tr -d ' ')
echo "input.txt: $LINES lines"
echo
echo "next:"
echo "  1. paste the puzzle's example into $DST/sample.txt"
echo "  2. open $DST/main.py and start solving"
