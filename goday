#!/usr/bin/env bash
# Scaffold a new AoC Go day and download input.
# Usage: ./goday <day> [year]
#   ./goday 1            -> 2024/day01
#   ./goday 5 2025       -> 2025/day05

set -euo pipefail

DAY="${1:-}"
YEAR="${2:-2024}"

if [[ -z "$DAY" ]]; then
  echo "usage: $0 <day> [year]" >&2
  exit 1
fi

if [[ -z "${COOKIE:-}" ]]; then
  echo "error: \$COOKIE not set (your AoC session cookie)" >&2
  exit 1
fi

DAY_PADDED=$(printf "%02d" "$DAY")
DST="$YEAR/day$DAY_PADDED"

if [[ -d "$DST" ]]; then
  echo "$DST already exists, refusing to overwrite" >&2
  exit 1
fi

if [[ ! -f "$YEAR/go.mod" ]]; then
  echo "creating $YEAR module..."
  mkdir -p "$YEAR"
  (cd "$YEAR" && go mod init "github.com/danschaffer/aoc/$YEAR")
fi

if [[ ! -d "$YEAR/template" ]]; then
  echo "error: $YEAR/template/ not found — copy it from 2024/template/" >&2
  exit 1
fi

cp -r "$YEAR/template" "$DST"
echo "created $DST"

INPUT_URL="https://adventofcode.com/$YEAR/day/$DAY/input"
echo "fetching $INPUT_URL ..."
curl -s --fail \
  --cookie "session=$COOKIE" \
  --user-agent "github.com/danschaffer/aoc by dan" \
  "$INPUT_URL" -o "$DST/input.txt"

touch "$DST/sample.txt"

LINES=$(wc -l < "$DST/input.txt" | tr -d ' ')
echo "input.txt: $LINES lines"
echo
echo "next:"
echo "  1. paste the puzzle's example into $DST/sample.txt"
echo "  2. open $DST/main.go, hit F5 to run"
